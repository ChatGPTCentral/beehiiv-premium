{
    "name": "Upgrade newsletter to premium (BULK - paste list)",
    "flow": [
        {
            "id": 1,
            "module": "util:SetVariable2",
            "version": 1,
            "parameters": {},
            "mapper": {
                "name": "emails",
                "scope": "roundtrip",
                "value": "email1@example.com\nemail2@example.com\nemail3@example.com"
            },
            "metadata": {
                "designer": {
                    "x": -100,
                    "y": -3
                },
                "restore": {
                    "expect": {
                        "scope": {
                            "label": "One cycle"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "name",
                        "type": "text",
                        "label": "Variable name",
                        "required": true
                    },
                    {
                        "name": "scope",
                        "type": "select",
                        "label": "Variable lifetime",
                        "required": true,
                        "validate": {
                            "enum": [
                                "roundtrip",
                                "execution"
                            ]
                        }
                    },
                    {
                        "name": "value",
                        "type": "any",
                        "label": "Variable value"
                    }
                ],
                "interface": [
                    {
                        "name": "emails",
                        "label": "emails",
                        "type": "any"
                    }
                ]
            }
        },
        {
            "id": 7,
            "module": "builtin:BasicFeeder",
            "version": 1,
            "parameters": {},
            "mapper": {
                "array": "{{split(replace(1.emails; \"/[\\r\\n;, ]+/g\"; \",\"); \",\")}}"
            },
            "metadata": {
                "designer": {
                    "x": 130,
                    "y": -3
                },
                "restore": {},
                "expect": [
                    {
                        "name": "array",
                        "type": "array",
                        "label": "Array"
                    }
                ]
            }
        },
        {
            "id": 6,
            "module": "beehiiv:CreateSubscriber",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 13988394
            },
            "filter": {
                "name": "Valid email (skip blank lines)",
                "conditions": [
                    [
                        {
                            "a": "{{7.value}}",
                            "o": "text:contain",
                            "b": "@"
                        }
                    ]
                ]
            },
            "mapper": {
                "email": "{{7.value}}",
                "reactivate_existing": true,
                "send_welcome_email": false,
                "double_opt_override": "not_set",
                "tier": "premium"
            },
            "metadata": {
                "designer": {
                    "x": 360,
                    "y": -283
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "My beehiiv (API Key) connection",
                            "data": {
                                "scoped": "true",
                                "connection": "beehiiv"
                            }
                        }
                    },
                    "expect": {
                        "double_opt_override": {
                            "label": "Not Set"
                        },
                        "tier": {
                            "label": "Premium"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:beehiiv4,beehiiv",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "email",
                        "type": "email",
                        "label": "Email address",
                        "required": true
                    },
                    {
                        "name": "reactivate_existing",
                        "type": "boolean",
                        "label": "Reactivate Existing?",
                        "required": true
                    },
                    {
                        "name": "send_welcome_email",
                        "type": "boolean",
                        "label": "Send Welcome Email?",
                        "required": true
                    },
                    {
                        "name": "double_opt_override",
                        "type": "select",
                        "label": "Double Opt-in Setting",
                        "required": true,
                        "validate": {
                            "enum": [
                                "on",
                                "off",
                                "not_set"
                            ]
                        }
                    },
                    {
                        "name": "tier",
                        "type": "select",
                        "label": "Tier",
                        "required": true,
                        "validate": {
                            "enum": [
                                "free",
                                "premium"
                            ]
                        }
                    },
                    {
                        "name": "stripe_customer_id",
                        "type": "text",
                        "label": "Stripe Customer ID"
                    }
                ],
                "advanced": true
            }
        },
        {
