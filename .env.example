# --- beehiiv ---
# API key (Settings -> Integrations -> API) with subscriptions:read + subscriptions:write scopes.
BEEHIIV_API_KEY=

# The publication whose subscribers you are upgrading (e.g. pub_685dd277-3d37-4105-9320-d248c9e28f76).
BEEHIIV_PUBLICATION_ID=

# OPTIONAL: a specific premium tier ID (tier_<uuid>). If unset, the subscriber is set to
# the generic "premium" tier. Set this when the publication has more than one premium tier.
# BEEHIIV_PREMIUM_TIER_ID=

# --- Stripe ---
# Secret key (sk_live_... or sk_test_...). Read access to customers + subscriptions is enough.
STRIPE_API_KEY=

# --- Web endpoint (Vercel) only ---
# Shared secret required by POST /api/upgrade (and the web form). Generate a long random
# string, e.g.  openssl rand -hex 32  . Not needed for the local CLI.
UPGRADE_API_TOKEN=
