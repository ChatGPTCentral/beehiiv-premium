{
  "name": "beehiiv-premium",
  "version": "1.0.0",
  "private": true,
  "description": "Upgrade a beehiiv subscriber to a premium tier and attach their paying Stripe customer, looked up by email.",
  "type": "commonjs",
  "main": "dist/cli.js",
  "bin": {
    "beehiiv-premium-upgrade": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "upgrade": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
